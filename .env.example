NODE_ENV=development
APP_NAME=GigaHub OS
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
DATABASE_URL=postgresql://gigahub:gigahub@localhost:5432/gigahub_os?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_ACCESS_SECRET=local-development-access-secret-change-before-production
JWT_REFRESH_SECRET=local-development-refresh-secret-change-before-production