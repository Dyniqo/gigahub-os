NODE_ENV=development
APP_NAME=GigaHub OS
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

DATABASE_URL=postgresql://gigahub:gigahub@localhost:55432/gigahub_os?schema=public

JWT_ACCESS_SECRET=local-development-access-secret-change-before-production
JWT_REFRESH_SECRET=local-development-refresh-secret-change-before-production

NPM_REGISTRY=https://registry.npmjs.org/
PRISMA_ENGINES_MIRROR=https://binaries.prisma.sh

# Optional: set only if you are behind a proxy or restricted network.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host.docker.internal