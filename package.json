  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build api && nest build worker",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "start:api": "nest start api",
    "start:api:dev": "nest start api --watch",
    "start:api:prod": "node dist/apps/api/main.js",
    "start:worker": "nest start worker",
    "start:worker:dev": "nest start worker --watch",
    "start:worker:prod": "node dist/apps/worker/main.js",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "format": "prettier --write \"{apps,libs,docs,prisma}/**/*.{ts,json,md,yml,yaml,prisma}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"{apps,libs,docs,prisma}/**/*.{ts,json,md,yml,yaml,prisma}\" \"*.{json,md,yml,yaml}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
