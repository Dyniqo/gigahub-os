generator client {
  provider            = "prisma-client"
  output              = "../libs/common/src/infrastructure/database/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  FREELANCER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum ProfileType {
  INDIVIDUAL
  AGENCY

  @@map("profile_type")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CONTRACTED
  CANCELLED
  COMPLETED

  @@map("project_status")
}

enum ProposalStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN

  @@map("proposal_status")
}

enum ContractStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
  DISPUTED

  @@map("contract_status")
}

enum MilestoneStatus {
  DRAFT
  FUNDED
  SUBMITTED
  APPROVED
  RELEASED
  DISPUTED
  CANCELLED

  @@map("milestone_status")
}

enum LedgerAccountType {
  CLIENT_ESCROW
  FREELANCER_EARNINGS
  PLATFORM_REVENUE
  PLATFORM_CLEARING

  @@map("ledger_account_type")
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT

  @@map("ledger_entry_direction")
}

enum LedgerEntryType {
  ESCROW_FUNDING
  ESCROW_RELEASE
  PLATFORM_FEE
  REFUND
  ADJUSTMENT

  @@map("ledger_entry_type")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ

  @@map("notification_status")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CANCELLED

  @@map("dispute_status")
}

enum DisputeOutcome {
  CLIENT_REFUND
  FREELANCER_RELEASE
  SPLIT_RELEASE
  CANCELLED

  @@map("dispute_outcome")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED

  @@map("outbox_status")
}

enum InboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED

  @@map("inbox_status")
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  email               String           @unique @db.VarChar(320)
  passwordHash        String           @map("password_hash") @db.VarChar(255)
  role                UserRole
  status              UserStatus       @default(ACTIVE)
  emailVerifiedAt     DateTime?        @map("email_verified_at") @db.Timestamptz(6)
  profile             Profile?
  refreshTokens       RefreshToken[]
  ownedProjects       Project[]        @relation("ClientProjects")
  submittedProposals  Proposal[]       @relation("FreelancerProposals")
  clientContracts     Contract[]       @relation("ClientContracts")
  freelancerContracts Contract[]       @relation("FreelancerContracts")
  ledgerAccounts      LedgerAccount[]
  sentMessages        Message[]        @relation("SentMessages")
  notifications       Notification[]
  openedDisputes      Dispute[]        @relation("DisputeOpenedBy")
  resolvedDisputes    Dispute[]        @relation("DisputeResolvedBy")
  auditLogs           AuditLog[]       @relation("AuditActor")
  idempotencyKeys     IdempotencyKey[]
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz(6)
  version             Int              @default(1)

  @@index([status])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Profile {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @unique @map("user_id") @db.Uuid
  type        ProfileType @default(INDIVIDUAL)
  displayName String      @map("display_name") @db.VarChar(120)
  headline    String?     @db.VarChar(160)
  bio         String?     @db.Text
  avatarUrl   String?     @map("avatar_url") @db.VarChar(2048)
  countryCode String?     @map("country_code") @db.Char(2)
  timezone    String?     @db.VarChar(64)
  hourlyRate  Decimal?    @map("hourly_rate") @db.Decimal(19, 4)
  currency    String?     @db.Char(3)
  skills      String[]    @default([])
  metadata    Json?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([type])
  @@index([countryCode])
  @@map("profiles")
}

model Project {
  id          String         @id @default(uuid()) @db.Uuid
  clientId    String         @map("client_id") @db.Uuid
  title       String         @db.VarChar(160)
  description String         @db.Text
  status      ProjectStatus  @default(DRAFT)
  budgetMin   Decimal?       @map("budget_min") @db.Decimal(19, 4)
  budgetMax   Decimal?       @map("budget_max") @db.Decimal(19, 4)
  currency    String         @default("USD") @db.Char(3)
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(6)
  closedAt    DateTime?      @map("closed_at") @db.Timestamptz(6)
  metadata    Json?
  client      User           @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  skills      ProjectSkill[]
  proposals   Proposal[]
  contract    Contract?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)
  version     Int            @default(1)

  @@index([clientId])
  @@index([status])
  @@index([publishedAt])
  @@map("projects")
}

model ProjectSkill {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String   @db.VarChar(80)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([projectId, name])
  @@index([name])
  @@map("project_skills")
}

model Proposal {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  freelancerId   String         @map("freelancer_id") @db.Uuid
  coverLetter    String         @map("cover_letter") @db.Text
  proposedAmount Decimal        @map("proposed_amount") @db.Decimal(19, 4)
  currency       String         @default("USD") @db.Char(3)
  deliveryDays   Int            @map("delivery_days")
  status         ProposalStatus @default(SUBMITTED)
  submittedAt    DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  decidedAt      DateTime?      @map("decided_at") @db.Timestamptz(6)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer     User           @relation("FreelancerProposals", fields: [freelancerId], references: [id], onDelete: Restrict)
  contract       Contract?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int            @default(1)

  @@unique([projectId, freelancerId])
  @@index([freelancerId])
  @@index([status])
  @@map("proposals")
}

model Contract {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String         @unique @map("project_id") @db.Uuid
  proposalId    String         @unique @map("proposal_id") @db.Uuid
  clientId      String         @map("client_id") @db.Uuid
  freelancerId  String         @map("freelancer_id") @db.Uuid
  status        ContractStatus @default(ACTIVE)
  totalAmount   Decimal        @map("total_amount") @db.Decimal(19, 4)
  currency      String         @default("USD") @db.Char(3)
  startedAt     DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime?      @map("ended_at") @db.Timestamptz(6)
  terms         Json?
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  proposal      Proposal       @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  client        User           @relation("ClientContracts", fields: [clientId], references: [id], onDelete: Restrict)
  freelancer    User           @relation("FreelancerContracts", fields: [freelancerId], references: [id], onDelete: Restrict)
  milestones    Milestone[]
  ledgerEntries LedgerEntry[]
  messages      Message[]
  disputes      Dispute[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int            @default(1)

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@map("contracts")
}

model Milestone {
  id            String          @id @default(uuid()) @db.Uuid
  contractId    String          @map("contract_id") @db.Uuid
  title         String          @db.VarChar(160)
  description   String?         @db.Text
  amount        Decimal         @db.Decimal(19, 4)
  currency      String          @default("USD") @db.Char(3)
  dueAt         DateTime?       @map("due_at") @db.Timestamptz(6)
  submittedAt   DateTime?       @map("submitted_at") @db.Timestamptz(6)
  approvedAt    DateTime?       @map("approved_at") @db.Timestamptz(6)
  releasedAt    DateTime?       @map("released_at") @db.Timestamptz(6)
  status        MilestoneStatus @default(DRAFT)
  contract      Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  dispute       Dispute?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int             @default(1)

  @@index([contractId])
  @@index([status])
  @@map("milestones")
}

model LedgerAccount {
  id        String            @id @default(uuid()) @db.Uuid
  ownerId   String?           @map("owner_id") @db.Uuid
  type      LedgerAccountType
  currency  String            @default("USD") @db.Char(3)
  owner     User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  entries   LedgerEntry[]
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerId])
  @@index([type])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id             String               @id @default(uuid()) @db.Uuid
  accountId      String               @map("account_id") @db.Uuid
  contractId     String?              @map("contract_id") @db.Uuid
  milestoneId    String?              @map("milestone_id") @db.Uuid
  transactionId  String               @map("transaction_id") @db.Uuid
  direction      LedgerEntryDirection
  type           LedgerEntryType
  amount         Decimal              @db.Decimal(19, 4)
  currency       String               @default("USD") @db.Char(3)
  idempotencyKey String?              @map("idempotency_key") @db.VarChar(160)
  referenceType  String?              @map("reference_type") @db.VarChar(80)
  referenceId    String?              @map("reference_id") @db.Uuid
  metadata       Json?
  account        LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contract       Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  milestone      Milestone?           @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId])
  @@index([contractId])
  @@index([milestoneId])
  @@index([transactionId])
  @@index([idempotencyKey])
  @@map("ledger_entries")
}

model Message {
  id          String    @id @default(uuid()) @db.Uuid
  contractId  String    @map("contract_id") @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  body        String    @db.Text
  attachments Json?
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([contractId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  type      String             @db.VarChar(120)
  title     String             @db.VarChar(160)
  body      String             @db.Text
  data      Json?
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?          @map("sent_at") @db.Timestamptz(6)
  readAt    DateTime?          @map("read_at") @db.Timestamptz(6)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([createdAt])
  @@map("notifications")
}

model Dispute {
  id             String          @id @default(uuid()) @db.Uuid
  contractId     String          @map("contract_id") @db.Uuid
  milestoneId    String          @unique @map("milestone_id") @db.Uuid
  openedById     String          @map("opened_by_id") @db.Uuid
  resolvedById   String?         @map("resolved_by_id") @db.Uuid
  status         DisputeStatus   @default(OPEN)
  outcome        DisputeOutcome?
  reason         String          @db.Text
  resolutionNote String?         @map("resolution_note") @db.Text
  contract       Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestone      Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  openedBy       User            @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedBy     User?           @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt     DateTime?       @map("resolved_at") @db.Timestamptz(6)
  version        Int             @default(1)

  @@index([contractId])
  @@index([openedById])
  @@index([resolvedById])
  @@index([status])
  @@map("disputes")
}

model OutboxEvent {
  id               String       @id @default(uuid()) @db.Uuid
  aggregateType    String       @map("aggregate_type") @db.VarChar(120)
  aggregateId      String       @map("aggregate_id") @db.Uuid
  aggregateVersion Int?         @map("aggregate_version")
  eventName        String       @map("event_name") @db.VarChar(160)
  eventVersion     Int          @default(1) @map("event_version")
  payload          Json
  headers          Json?
  status           OutboxStatus @default(PENDING)
  attempts         Int          @default(0)
  nextAttemptAt    DateTime?    @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt         DateTime?    @map("locked_at") @db.Timestamptz(6)
  publishedAt      DateTime?    @map("published_at") @db.Timestamptz(6)
  error            String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
  @@map("outbox_events")
}

model InboxEvent {
  id          String      @id @default(uuid()) @db.Uuid
  eventId     String      @map("event_id") @db.Uuid
  consumer    String      @db.VarChar(120)
  eventName   String      @map("event_name") @db.VarChar(160)
  payloadHash String?     @map("payload_hash") @db.VarChar(128)
  status      InboxStatus @default(RECEIVED)
  attempts    Int         @default(0)
  processedAt DateTime?   @map("processed_at") @db.Timestamptz(6)
  error       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([eventId, consumer])
  @@index([status, createdAt])
  @@map("inbox_events")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(120)
  resourceType String   @map("resource_type") @db.VarChar(120)
  resourceId   String?  @map("resource_id") @db.Uuid
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  metadata     Json?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  scope          String    @db.VarChar(120)
  key            String    @db.VarChar(160)
  requestHash    String    @map("request_hash") @db.VarChar(128)
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
